# Network
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Parent account you created with the faucet. The contract is deployed here and this
# account is also the owner, round manager and liquidity seeder in the demo.
# Its key is read from ~/.near-credentials/<network>/<account>.json (near-cli legacy keychain)
# unless LEAGUE_PRIVATE_KEY is set.
LEAGUE_ACCOUNT=agent-league.testnet
LEAGUE_PRIVATE_KEY=

# Verifier keys: run `npm run verifier:keygen` and paste both lines here.
VERIFIER_SECRET_KEYS=
VERIFIER_PUBLIC_KEYS=
VERIFIER_THRESHOLD=2
VERIFIER_PORT=8787
VERIFIER_URL=http://localhost:8787
# Stake per verifier key; signatures from keys below it do not count
VERIFIER_STAKE_NEAR=0.1
# Scores wait this long for disputes before they pay out
DISPUTE_WINDOW_SECONDS=120

# Arbiters decide disputes (npm run verifier:keygen). In production an independent party holds them.
ARBITER_SECRET_KEYS=
ARBITER_PUBLIC_KEYS=

# Open League inference (NEAR AI Cloud, OpenAI-compatible API). Not needed in sim mode.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# Demo amounts in NEAR (kept small so a faucet account is enough)
BOUNTY_NEAR=0.3
# Market maker subsidy per round (its maximum loss)
SUBSIDY_NEAR=0.3
BUILDER_STAKE_NEAR=0.1
SCOUT_BET_NEAR=0.2
