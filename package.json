{
  "name": "benchmarket",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:contract": "cd contract && cargo test",
    "build:contract": "cd contract && cargo near build non-reproducible-wasm",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "verifier": "npm run start -w @benchmarket/verifier",
    "verifier:keygen": "npm run keygen -w @benchmarket/verifier",
    "setup": "tsx packages/orchestrator/src/cli.ts setup",
    "round": "tsx packages/orchestrator/src/cli.ts round",
    "demo": "tsx packages/orchestrator/src/cli.ts demo",
    "status": "tsx packages/orchestrator/src/cli.ts status",
    "bench": "tsx packages/orchestrator/src/cli.ts bench",
    "web": "npm run dev --workspace=packages/web",
    "web:build": "npm run build --workspace=packages/web",
    "evidence": "npm run web:build && rm -rf evidence/data && mkdir -p evidence && cp -r packages/web/dist/data evidence/data",
    "mcp": "tsx packages/mcp/src/server.ts",
    "upgrade": "tsx packages/orchestrator/src/cli.ts upgrade",
    "identities": "tsx packages/orchestrator/src/cli.ts identities",
    "league": "tsx packages/orchestrator/src/cli.ts",
    "agent": "tsx packages/agent/src/cli.ts",
    "configure": "tsx packages/orchestrator/src/cli.ts configure"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
